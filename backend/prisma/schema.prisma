generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String        @id @default(uuid())
  name      String
  email     String        @unique
  password  String
  createdAt DateTime      @default(now())
  incomes   IncomeEntry[]
}

model IncomeEntry {
  id          String   @id @default(uuid())
  platform    String
  amount      Float
  status      String
  payoutDate  DateTime
  createdAt   DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])
}